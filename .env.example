# Copy to .env and fill in. Never commit .env.

# AI provider. Use mock to try the app without a key (answers are canned placeholders).
LLM_PROVIDER=          # claude | openai | groq | gemini | mock (mock needs no key)
LLM_API_KEY=
# Optional; defaults: claude-sonnet-5-5, gpt-4o-mini, openai/gpt-oss-120b (groq), gemini-2.0-flash
# Groq retired llama-3.3-70b-versatile on 2026-08-16. List usable models: python scripts/list_groq_models.py
LLM_MODEL=

# Day 7: Google OAuth (leave empty to run on sample emails)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

FRONTEND_ORIGIN=http://localhost:3000

# Optional file locations (defaults are inside data/, which is gitignored for runtime files)
# DRAFTS_FILE=
# GOOGLE_TOKEN_FILE=
# ACTIVITY_FILE=
